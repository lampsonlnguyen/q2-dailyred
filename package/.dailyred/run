#!/bin/sh
# Q2 Pod tracks the PID it starts for gameview, input, and audio=2.
# Keep that PID alive: after copying the binary off the SD card, replace
# this shell with the game itself. Do NOT background the game or use a
# restart loop: either would make the firmware believe the game has exited
# while its orphan still owns the framebuffer or ALSA.
set -eu
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cp -f "$dir/q2-dailyred" /tmp/q2-dailyred.bin
chmod 755 /tmp/q2-dailyred.bin

# The app redirects stderr to /mnt/mmc/dailyred/q2-dailyred.log itself.
# Allow the game to be reclaimed before Q2 Pod's own process under OOM.
echo 1000 > /proc/self/oom_score_adj 2>/dev/null || true
cd /tmp
exec /tmp/q2-dailyred.bin
